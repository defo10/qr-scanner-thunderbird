{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "qr-mail-scanner@dast.xyz",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "storage",
    "clipboardWrite",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'"
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "message_display_action": {
    "default_title": "__MSG_scanActionTitle__",
    "default_icon": "icons/icon.svg"
  }
}
